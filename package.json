{
  "name": "wolfari",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo:init": "node scripts/demo.mjs init",
    "demo:start": "node scripts/demo.mjs start",
    "demo:check": "node scripts/demo.mjs check",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:api": "node scripts/demo.mjs api",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:reset": "node scripts/demo.mjs reset",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/cli.mjs dev:check",
    "env:init": "node scripts/cli.mjs env:init",
    "infra:up": "node scripts/cli.mjs infra:up",
    "infra:down": "node scripts/cli.mjs infra:down",
    "infra:check": "node scripts/cli.mjs infra:check",
    "db:status": "node scripts/cli.mjs db:status",
    "db:migrate": "node scripts/cli.mjs db:migrate",
    "db:inspect": "node scripts/cli.mjs db:inspect",
    "db:test": "corepack pnpm build && node scripts/database-integration.mjs",
    "identity:test": "corepack pnpm build && node scripts/identity-integration.mjs",
    "trip:test": "corepack pnpm build && node scripts/trip-integration.mjs",
    "trip:invitations:test": "corepack pnpm build && node scripts/trip-integration.mjs --invitations",
    "trip:members:test": "corepack pnpm build && node scripts/trip-integration.mjs --members",
    "price-watch:test": "corepack pnpm build && node scripts/trip-integration.mjs --price-watch",
    "notification:test": "corepack pnpm build && node scripts/trip-integration.mjs --notifications",
    "trip:retry-lifecycle": "node scripts/trip-retry-lifecycle.mjs",
    "trip:retry-finance": "node scripts/trip-retry-finance.mjs",
    "trip:replay-invitation": "node scripts/trip-replay-invitation.mjs",
    "identity:replay-email": "node scripts/identity-replay-email.mjs",
    "contracts:lint": "node scripts/contracts.mjs lint",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:test": "vitest run packages/contracts scripts/contracts.test.ts",
    "contracts:breaking": "node scripts/contracts.mjs breaking",
    "dev:test": "node scripts/launcher-test.mjs",
    "finance:outbox:test": "corepack pnpm build && node scripts/finance-outbox-integration.mjs",
    "finance:replay-outbox": "node scripts/finance-replay-outbox.mjs",
    "finance:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance",
    "finance:automation-context:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-automation-context",
    "finance:expenses:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-expenses",
    "finance:notes:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-notes",
    "finance:refunds:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-refunds",
    "finance:closures:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-closures",
    "finance:payments:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-payments",
    "finance:lifecycle:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-lifecycle"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "amqplib": "2.0.1",
    "eslint": "10.10.0",
    "minio": "8.0.7",
    "pg": "8.23.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
