{
  "name": "wolfari",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "trial:init": "node scripts/trial.mjs init",
    "trial:check": "node scripts/trial.mjs check",
    "trial:health": "node scripts/trial.mjs health",
    "trial:migrate": "node scripts/trial.mjs migrate",
    "trial:compose": "node scripts/trial.mjs compose",
    "trial:storage": "node scripts/trial-storage.mjs",
    "demo:init": "node scripts/demo.mjs init",
    "demo:start": "node scripts/demo.mjs start",
    "demo:check": "node scripts/demo.mjs check",
    "demo:accounts": "node scripts/demo.mjs accounts",
    "demo:acceptance": "corepack pnpm build && node scripts/trip-integration.mjs --demo1",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:api": "node scripts/demo.mjs api",
    "demo:finance-price-watch": "node scripts/demo.mjs finance-price-watch",
    "demo:unit": "vitest run apps/finance-service/src/domain/contribution-request.test.ts apps/finance-service/src/domain/contribution-request-creation.test.ts apps/finance-service/src/domain/contribution-transition.test.ts apps/automation-service/src/price-watch/price-watch.domain.test.ts apps/automation-service/src/price-watch/price-alert.domain.test.ts --reporter=default --reporter=junit --outputFile.junit=.local/demo/reports/finance-price-watch-unit.xml",
    "demo:postman": "node scripts/demo.mjs postman",
    "demo:perf:smoke": "node scripts/demo-performance.mjs PERF01",
    "demo:perf:load": "node scripts/demo-performance.mjs PERF02",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:tunnel": "node scripts/demo-tunnel.mjs",
    "demo:reset": "node scripts/demo.mjs reset",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/cli.mjs dev:check",
    "env:init": "node scripts/cli.mjs env:init",
    "infra:up": "node scripts/cli.mjs infra:up",
    "infra:down": "node scripts/cli.mjs infra:down",
    "infra:check": "node scripts/cli.mjs infra:check",
    "db:status": "node scripts/cli.mjs db:status",
    "db:migrate": "node scripts/cli.mjs db:migrate",
    "db:inspect": "node scripts/cli.mjs db:inspect",
    "db:test": "corepack pnpm build && node scripts/database-integration.mjs",
    "identity:test": "corepack pnpm build && node scripts/identity-integration.mjs",
    "trip:test": "corepack pnpm build && node scripts/trip-integration.mjs",
    "trip:invitations:test": "corepack pnpm build && node scripts/trip-integration.mjs --invitations",
    "trip:members:test": "corepack pnpm build && node scripts/trip-integration.mjs --members",
    "price-watch:setup": "node scripts/cli.mjs price-watch:setup",
    "price-watch:test": "corepack pnpm build && node scripts/trip-integration.mjs --price-watch",
    "price-watch:live-check": "corepack pnpm --filter \"@wolfari/automation-service...\" build && node scripts/price-watch-live-check.mjs",
    "notification:test": "corepack pnpm build && node scripts/trip-integration.mjs --notifications",
    "trip:retry-lifecycle": "node scripts/trip-retry-lifecycle.mjs",
    "trip:retry-finance": "node scripts/trip-retry-finance.mjs",
    "trip:replay-invitation": "node scripts/trip-replay-invitation.mjs",
    "identity:replay-email": "node scripts/identity-replay-email.mjs",
    "poi:fetch": "node --env-file=.env scripts/poi/fetch-coordinates.mjs",
    "poi:candidates": "node --env-file=.env scripts/poi/find-candidates.mjs",
    "poi:review": "node scripts/poi/review.mjs",
    "poi:load": "corepack pnpm --filter @wolfari/common build && node scripts/poi/load-golden.mjs",
    "poi:overture": "corepack pnpm --filter @wolfari/common build && node scripts/poi/overture.mjs",
    "poi:snapshots": "node scripts/poi/snapshots.mjs list",
    "poi:activate": "node scripts/poi/snapshots.mjs activate",
    "poi:prune": "node scripts/poi/snapshots.mjs prune",
    "poi:gates": "node scripts/poi/gates.mjs",
    "contracts:lint": "node scripts/contracts.mjs lint",
    "contracts:rest": "node scripts/rest-contracts.mjs && corepack pnpm exec vitest run packages/contracts/src/demo1-openapi.test.ts",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:test": "vitest run packages/contracts scripts/contracts.test.ts",
    "contracts:breaking": "node scripts/contracts.mjs breaking",
    "dev:test": "node scripts/launcher-test.mjs",
    "finance:outbox:test": "corepack pnpm build && node scripts/finance-outbox-integration.mjs",
    "finance:notification:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-notifications",
    "finance:replay-outbox": "node scripts/finance-replay-outbox.mjs",
    "finance:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance",
    "finance:history:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-history",
    "finance:automation-context:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-automation-context",
    "finance:expenses:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-expenses",
    "finance:notes:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-notes",
    "finance:refunds:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-refunds",
    "finance:handovers:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-handovers",
    "finance:bank-webhook:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-bank-webhook",
    "finance:closures:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-closures",
    "finance:payments:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-payments",
    "finance:lifecycle:test": "corepack pnpm build && node scripts/trip-integration.mjs --finance-lifecycle",
    "mobile:completion:test": "corepack pnpm build && node scripts/trip-integration.mjs --mobile-completion"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "amqplib": "2.0.1",
    "eslint": "10.10.0",
    "minio": "8.0.7",
    "pg": "8.23.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.4"
  }
}
