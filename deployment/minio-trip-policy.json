{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["s3:ListBucket", "s3:GetBucketLocation"], "Resource": ["arn:aws:s3:::wolfari-trip-covers", "arn:aws:s3:::wolfari-trip-dress-images"] },
    { "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"], "Resource": ["arn:aws:s3:::wolfari-trip-covers/*", "arn:aws:s3:::wolfari-trip-dress-images/*"] }
  ]
}
