  trips ||--o{ trip_plan_editors : "trip_id"
  trip_members ||--o| trip_plan_editors : "trip_member_id, trip_id"
  trips ||--o{ selected_locations : "trip_id"
  trips ||--o{ activities : "trip_id"
  selected_locations |o--o{ activities : "selected_location_id, trip_id"
  trips ||--o{ dress_codes : "trip_id"
  activities |o--o{ dress_codes : "activity_id, trip_id"
  trips ||--o{ packing_items : "trip_id"
  trip_members |o--o{ packing_items : "assigned_member_id, trip_id"
  trips ||--o{ share_links : "trip_id"
  trips ||--o{ recommendation_receipts : "trip_id"
  trips ||--o{ export_jobs : "trip_id"
  export_presets |o--o{ export_jobs : "export_preset_id"
  trips ||--o{ trip_audit_logs : "trip_id"
