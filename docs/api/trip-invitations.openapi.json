  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "invitation_type": {
            "type": "string",
            "enum": ["EMAIL", "LINK"]
          },
          "email": {
            "type": ["string", "null"],
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "id",
          "trip_id",
          "invitation_type",
          "email",
          "status",
          "expires_at",
          "resolved_at",
          "version"
        ]
      },
