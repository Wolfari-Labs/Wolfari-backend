        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_name": {
            "type": "string"
          },
          "inviter_display_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "trip_name", "inviter_display_name", "status", "expires_at"]
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^inv1_[A-Za-z0-9_-]{43}$",
            "writeOnly": true
          }
        },
        "required": ["token"]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": ["expected_version"]
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invitation_type": {
            "type": "string",
            "enum": ["EMAIL", "LINK"]
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "expected_membership_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": ["invitation_type", "expected_membership_revision"],
        "allOf": [
          {
            "if": {
              "properties": {
                "invitation_type": {
                  "const": "EMAIL"
                }
              }
            },
            "then": {
              "required": ["email"]
            },
            "else": {
              "not": {
                "required": ["email"]
              }
            }
          }
        ]
      },
      "Created": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/Invitation"
          },
          "one_time_link": {
            "type": "string",
            "format": "uri",
            "description": "Chỉ có ở response tạo mới đầu tiên; bị bỏ qua khi replay."
          }
        },
        "required": ["invitation"]
      },
      "Managed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/Invitation"
          }
        },
        "required": ["invitation"]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            }
          },
          "next_cursor": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        },
        "required": ["items", "next_cursor"]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "membership": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "trip_id": {
                "type": "string",
                "format": "uuid"
              },
              "user_id": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "type": "string",
                "const": "MEMBER"
              },
              "joined_at": {
                "type": "string",
                "format": "date-time"
              },
              "left_at": {
                "type": "null"
              }
            },
            "required": ["id", "trip_id", "user_id", "role", "joined_at", "left_at"]
          },
          "revisions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "plan_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "membership_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "export_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": ["plan_version", "membership_revision", "export_revision"]
          }
        },
        "required": ["membership", "revisions"]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "PERMISSION_DENIED",
                  "RESOURCE_NOT_FOUND",
                  "VERSION_CONFLICT",
                  "STATE_CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": ["object", "null"],
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": ["code", "message", "details", "retryable"]
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "correlation_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["correlation_id"]
          }
        },
        "required": ["error", "meta"]
      }
    }
  }
}
