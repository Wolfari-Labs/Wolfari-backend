{
  "openapi": "3.1.0",
  "info": {
    "title": "Travel place search",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/travel/places": {
      "get": {
        "operationId": "searchPlaces",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "trip_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "data is a place array; meta includes SUCCESS/NO_RESULT/ERROR, provider, fetched_at, stale, is_mock=false, warnings and attribution. Missing server key returns ERROR/PROVIDER_NOT_CONFIGURED, never mock results."
          },
          "401": {
            "description": "Unauthenticated"
          },
          "404": {
            "description": "No current Trip access"
          },
          "429": {
            "description": "Per-account search limit"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
