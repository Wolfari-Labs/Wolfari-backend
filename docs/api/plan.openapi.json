  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details", "retryable"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "nullable": true,
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "correlation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "PlanVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trip_id", "plan_version", "export_revision"],
        "properties": {
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "export_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "Activity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trip_id",
          "title",
          "activity_type",
          "description",
          "public_description",
          "selected_location_id",
          "starts_at",
          "ends_at",
          "scheduled_date",
          "position",
          "status",
          "source",
          "completed_by_user_id",
