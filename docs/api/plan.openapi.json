{
  "openapi": "3.0.3",
  "info": {
    "title": "Wolfari Plan / Activity",
    "version": "1.1.0",
    "description": "Demo 1 addendum v1.0. Read projections for Locations/Dress/Packing do not imply public writers. scheduled_date is additive; old request hashes are preserved when omitted."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Native development; local demo Gateway port is 13000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/trips/{trip_id}/plan": {
      "get": {
        "operationId": "getPlan",
        "summary": "API039 Read shared Plan",
        "description": "Active membership required; structural edits require Plan Editor, completion follows actor attribution. Writes check expected_plan_version and current permissions on replay. Omitted PATCH fields retain values; null clears. Trip interval is [start_at,end_at); scheduled_date is a Trip-timezone day intersecting that interval. Timed changes clear scheduled_date atomically, conflicting explicit modes fail. No multi-item time cascade. Web uses Bearer access plus Origin/CSRF convention from identity.openapi.yaml; never call internal RPC directly.",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted result; replay returns saved receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["data", "meta"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Plan"
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["correlation_id"],
                      "properties": {
                        "correlation_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "PERMISSION_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "VERSION_CONFLICT, IDEMPOTENCY_CONFLICT or STATE_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE; write outcome may be unknown",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
