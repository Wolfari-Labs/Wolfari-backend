{
  "openapi": "3.1.0",
  "info": {
    "title": "Wolfari DSS recommendations (FR-DS01/FR-DS03)",
    "version": "1.0.0",
    "description": "Rule-based packing and dress-code suggestions with reasons. Preview never changes the Plan; apply writes only the selected items (source DSS), bumps plan_version once and is idempotent by Idempotency-Key. Previews expire after 30 minutes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ],
  "paths": {
    "/api/v1/trips/{id}/recommendations": {
      "post": {
        "operationId": "previewRecommendation",
        "description": "Any active trip member. Stores a preview; the Plan is not changed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": ["PACKING", "DRESS_CODE", "ALL"],
                    "default": "ALL"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "activity_ids": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Preview stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recommendation"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "correlation_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/recommendations/{id}/apply": {
      "post": {
        "operationId": "applyRecommendation",
        "description": "Editors only. 409 VERSION_CONFLICT when the Plan changed since preview; 409 STATE_CONFLICT (details.reason EXPIRED) when expired.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item_ids", "expected_plan_version"],
                "properties": {
                  "item_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{24}$"
                    }
                  },
                  "expected_plan_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recommendation"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "correlation_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/recommendations/{id}/ignore": {
      "post": {
        "operationId": "ignoreRecommendation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Marked REJECTED.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recommendation"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "correlation_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wolfari_access"
      }
    },
    "responses": {
      "Error": {
        "description": "Validation, authentication, permission or conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": ["PACKING", "DRESS_CODE", "ALL"]
          },
          "status": {
            "enum": ["PREVIEWED", "APPLIED", "REJECTED", "EXPIRED"]
          },
          "rule_version": {
            "type": "string"
          },
          "base_plan_version": {
            "type": "integer"
          },
          "applied_plan_version": {
            "type": ["integer", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "can_apply": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationItem"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "applied": {
            "type": ["object", "null"]
          }
        }
      },
      "RecommendationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "kind": {
            "enum": ["PACKING", "DRESS_CODE"]
          },
          "rule_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ALREADY_IN_PLAN, MANUAL_DRESS_CODE, ACTIVITY_REMOVED"
          },
          "packing_item": {
            "type": "object"
          },
          "dress_code": {
            "type": "object"
          }
        }
      }
    }
  }
}
