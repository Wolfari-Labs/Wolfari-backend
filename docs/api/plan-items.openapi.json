  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "meta"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "nullable": true,
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "correlation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "PlanVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trip_id",
          "plan_version",
          "export_revision"
        ],
        "properties": {
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "export_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "DressCode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trip_id",
          "scope_type",
          "plan_date",
          "activity_id",
          "label",
          "description",
          "public_description",
          "source",
          "plan_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope_type": {
            "type": "string",
            "enum": [
              "TRIP",
              "DAY",
              "ACTIVITY"
            ]
          },
          "plan_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "nullable": true
          },
          "activity_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
