{
  "openapi": "3.1.0",
  "info": {
    "title": "Wolfari Places and Selected Locations",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ],
  "paths": {
    "/api/v1/trips/{tripId}/places/search": {
      "get": {
        "operationId": "searchTripPlaces",
        "description": "Authenticated trip reader only. Explicit submit; no autocomplete. May return labelled stale cache.",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "default": 16.0544
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "default": 108.2022
            }
          },
          {
            "name": "radius_m",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 20000,
              "default": 5000
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "enum": ["tourism", "restaurant", "cafe", "accommodation"],
              "default": "tourism"
            }
          },
          {
            "name": "geocode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Normalized search results; empty and provider failure are explicit meta states.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "401": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "403": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "404": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "409": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "503": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          }
        }
      }
    },
    "/api/v1/trips/{tripId}/selected-locations": {
      "post": {
        "operationId": "saveTripLocation",
        "description": "Plan editor only. Signed actor/trip-bound provider snapshot OR manual pin. Cookie auth requires CSRF; durable idempotency receipt and optimistic plan version.",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ManualSelection"
                  },
                  {
                    "$ref": "#/components/schemas/ProviderSelection"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved or deduplicated; data is LocationMutation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LocationMutation"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "401": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "403": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "404": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "409": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "503": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          }
        }
      }
    },
    "/api/v1/trips/{tripId}/selected-locations/{locationId}": {
      "delete": {
        "operationId": "deleteTripLocation",
        "description": "Plan editor only, CSRF for cookie. Refuses linked activities (409). Does not cascade-delete activities.",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expected_plan_version"],
                "properties": {
                  "expected_plan_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted; data is LocationMutation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LocationMutation"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "401": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "403": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "404": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "409": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          },
          "503": {
            "description": "Validation, authentication, authorization, state/version conflict or unavailable service. No upstream secrets."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wolfari_access"
      }
    },
    "schemas": {
      "ManualSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_plan_version", "name", "latitude", "longitude"],
        "properties": {
          "expected_plan_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "maxLength": 1000
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "ProviderSelection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_plan_version", "selection_token"],
        "properties": {
          "expected_plan_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "selection_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        }
      },
      "LocationMutation": {
        "type": "object",
        "required": ["location_id", "version"],
        "properties": {
          "location_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "object",
            "required": ["trip_id", "plan_version", "export_revision"],
            "properties": {
              "trip_id": {
                "type": "string",
                "format": "uuid"
              },
              "plan_version": {
                "type": "integer",
                "minimum": 1
              },
              "export_revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "Place": {
        "type": "object",
        "required": ["id", "name", "coordinates", "selection_token", "attribution"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 2048
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "coordinates": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "selection_token": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Place"
            }
          },
          "meta": {
            "type": "object",
            "required": ["provider", "status", "stale", "is_mock"],
            "properties": {
              "provider": {
                "const": "GEOAPIFY"
              },
              "status": {
                "enum": ["SUCCESS", "NO_RESULT", "ERROR"]
              },
              "stale": {
                "type": "boolean"
              },
              "is_mock": {
                "const": false
              },
              "fetched_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
