{
  "openapi": "3.0.3",
  "info": {
    "title": "Wolfari Finance Payment Sandbox API",
    "version": "1.0.0",
    "description": "API090-095 for creating and reading MoMo Sandbox payment attempts, requesting reconciliation, durably receiving MoMo IPN, and reviewing payment exceptions."
  },
  "paths": {
    "/api/v1/contributions/{contribution_id}/payment-attempts": {
      "post": {
        "summary": "API090 Self creates a MoMo Sandbox payment attempt",
        "parameters": [
          { "$ref": "#/components/parameters/ContributionId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePaymentAttemptInput" }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/PaymentAttemptAccepted" }
        }
      }
    },
    "/api/v1/payment-attempts/{payment_attempt_id}": {
      "get": {
        "summary": "API091 Self or current Holder reads a payment attempt",
        "parameters": [{ "$ref": "#/components/parameters/PaymentAttemptId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/PaymentAttempt" }
        }
      }
    },
    "/api/v1/payment-attempts/{payment_attempt_id}/reconcile": {
      "post": {
        "summary": "API092 current Holder requests provider reconciliation",
        "parameters": [
          { "$ref": "#/components/parameters/PaymentAttemptId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReconcilePaymentAttemptInput" }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/Operation" }
        }
      }
    },
    "/api/v1/webhooks/momo": {
      "post": {
        "summary": "API093 receives and durably records a MoMo IPN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MomoIpnInput" } }
          }
        },
        "responses": {
          "204": { "description": "The callback receipt was stored or deduplicated" }
        }
      }
    },
    "/api/v1/funds/{fund_id}/payment-exceptions": {
      "get": {
        "summary": "API094 current Owner or Holder lists payment exceptions",
        "parameters": [
          { "$ref": "#/components/parameters/FundId" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaymentExceptionPage" }
        }
      }
    },
    "/api/v1/payment-exceptions/{payment_exception_id}/resolve": {
      "post": {
        "summary": "API095 current Holder resolves a reviewed payment exception",
        "parameters": [
          { "$ref": "#/components/parameters/PaymentExceptionId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResolvePaymentExceptionInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/PaymentException" },
          "202": { "$ref": "#/components/responses/Operation" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ContributionId": {
        "name": "contribution_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "PaymentAttemptId": {
        "name": "payment_attempt_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "FundId": {
        "name": "fund_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "PaymentExceptionId": {
        "name": "payment_exception_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "responses": {
      "PaymentAttemptAccepted": {
        "description": "Attempt persisted, or its durable operation is still being recovered",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                { "$ref": "#/components/schemas/PaymentAttemptEnvelope" },
                { "$ref": "#/components/schemas/OperationEnvelope" }
              ]
            }
          }
        }
      },
      "PaymentAttempt": {
        "description": "Safe payment-attempt projection",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PaymentAttemptEnvelope" }
          }
        }
      },
      "PaymentException": {
        "description": "Safe payment-exception projection",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PaymentExceptionEnvelope" }
          }
        }
      },
      "PaymentExceptionPage": {
        "description": "Fund-scoped payment exceptions without raw provider material",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/PaymentExceptionPageEnvelope" }
          }
        }
      },
      "Operation": {
        "description": "Durable operation accepted for recovery",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/OperationEnvelope" } }
        }
      }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" },
      "Version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
      "MomoAmount": {
        "type": "string",
        "pattern": "^(?:[1-9][0-9]{3,6}|[1-4][0-9]{7}|50000000)$",
        "description": "MoMo one-time-payment amount from 1,000 through 50,000,000 VND"
      },
      "PaymentAttemptStatus": {
        "type": "string",
        "enum": ["CREATED", "PENDING", "SUCCEEDED", "FAILED", "EXPIRED"]
      },
      "PaymentExceptionStatus": {
        "type": "string",
        "enum": ["NEEDS_REVIEW", "PROCESSED", "IGNORED"]
      },
      "CreatePaymentAttemptInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "expected_version", "expected_finance_version"],
        "properties": {
          "provider": { "type": "string", "enum": ["MOMO_SANDBOX"] },
          "expected_version": { "$ref": "#/components/schemas/Version" },
          "expected_finance_version": { "$ref": "#/components/schemas/Version" }
        }
      },
      "ReconcilePaymentAttemptInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      },
      "ResolveLinkedPaymentExceptionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolution", "linked_attempt_id", "reason", "expected_finance_version"],
        "properties": {
          "resolution": { "type": "string", "enum": ["LINKED"] },
          "linked_attempt_id": { "$ref": "#/components/schemas/Uuid" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "expected_finance_version": { "$ref": "#/components/schemas/Version" }
        }
      },
      "ResolveNoFinancialEffectInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolution", "reason", "expected_finance_version"],
        "properties": {
          "resolution": { "type": "string", "enum": ["NO_FINANCIAL_EFFECT"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "expected_finance_version": { "$ref": "#/components/schemas/Version" }
        }
      },
      "ResolvePaymentExceptionInput": {
        "oneOf": [
          { "$ref": "#/components/schemas/ResolveLinkedPaymentExceptionInput" },
          { "$ref": "#/components/schemas/ResolveNoFinancialEffectInput" }
        ]
      },
      "MomoProviderInteger": {
        "oneOf": [
          { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          { "type": "string", "pattern": "^[0-9]+$", "maxLength": 40 }
        ]
      },
      "MomoProviderAmount": {
        "oneOf": [
          { "type": "integer", "minimum": 1000, "maximum": 50000000 },
          { "$ref": "#/components/schemas/MomoAmount" }
        ]
      },
      "MomoIpnInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partnerCode",
          "orderId",
          "requestId",
          "amount",
          "orderInfo",
          "orderType",
          "transId",
          "resultCode",
          "message",
          "payType",
          "responseTime",
          "extraData",
          "signature"
        ],
        "properties": {
          "partnerCode": { "type": "string", "minLength": 1, "maxLength": 100 },
          "orderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[0-9A-Za-z](?:[-_.]*[0-9A-Za-z]+)*$"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[0-9A-Za-z-]+$"
          },
          "amount": { "$ref": "#/components/schemas/MomoProviderAmount" },
          "orderInfo": { "type": "string", "minLength": 1, "maxLength": 255 },
          "orderType": { "type": "string", "minLength": 1, "maxLength": 50 },
          "transId": { "$ref": "#/components/schemas/MomoProviderInteger" },
          "resultCode": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
          "message": { "type": "string", "minLength": 1, "maxLength": 255 },
          "payType": { "type": "string", "minLength": 1, "maxLength": 50 },
          "responseTime": { "$ref": "#/components/schemas/MomoProviderInteger" },
          "extraData": { "type": "string", "maxLength": 4096, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
          "signature": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      },
      "PaymentAttempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contribution_id",
          "provider",
          "environment",
          "amount",
          "currency",
          "status",
          "needs_reconciliation",
          "payment_url",
          "expires_at",
          "error_code",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "contribution_id": { "$ref": "#/components/schemas/Uuid" },
          "provider": { "type": "string", "enum": ["MOMO_SANDBOX"] },
          "environment": { "type": "string", "enum": ["SANDBOX"] },
          "amount": { "$ref": "#/components/schemas/MomoAmount" },
          "currency": { "type": "string", "enum": ["VND"] },
          "status": { "$ref": "#/components/schemas/PaymentAttemptStatus" },
          "needs_reconciliation": { "type": "boolean" },
          "payment_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://test-payment\\.momo\\.vn(?:/|$)",
            "nullable": true
          },
          "expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "error_code": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentException": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "payment_attempt_id",
          "processing_status",
          "review_reason",
          "received_at",
          "reviewed_at"
        ],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "payment_attempt_id": { "type": "string", "format": "uuid", "nullable": true },
          "processing_status": { "$ref": "#/components/schemas/PaymentExceptionStatus" },
          "review_reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "received_at": { "type": "string", "format": "date-time" },
          "reviewed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correlation_id"],
        "properties": { "correlation_id": { "$ref": "#/components/schemas/Uuid" } }
      },
      "PaymentAttemptEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/PaymentAttempt" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "PaymentExceptionEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/PaymentException" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "PaymentExceptionPageEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "next_cursor"],
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PaymentException" }
              },
              "next_cursor": { "type": "string", "nullable": true }
            }
          },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "OperationEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "object" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      }
    }
  }
}
