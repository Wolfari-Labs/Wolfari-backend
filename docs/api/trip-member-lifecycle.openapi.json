  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LifecycleCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "expected_membership_revision"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Trimmed; must not be blank"
          },
          "expected_membership_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "Membership": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trip_id", "user_id", "role", "joined_at", "left_at"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": ["OWNER", "MEMBER"]
          },
          "joined_at": {
            "type": "string",
            "format": "date-time"
          },
          "left_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "trip_id", "state"],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "trip_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": ["PROCESSING", "PENDING_RECOVERY", "SUCCEEDED", "FAILED", "NEEDS_REVIEW"]
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["COMMITTED", "REJECTED", "CANCELLED"]
              },
              "error_code": {
                "type": "string",
                "enum": ["FINANCE_OBLIGATION_BLOCKED", "STATE_CONFLICT", "VERSION_CONFLICT"]
              }
            }
          },
          "error_code": {
            "type": "string",
            "enum": ["FINANCE_OBLIGATION_BLOCKED", "STATE_CONFLICT", "VERSION_CONFLICT"]
          },
          "next_retry_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details", "retryable"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "nullable": true,
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "correlation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
