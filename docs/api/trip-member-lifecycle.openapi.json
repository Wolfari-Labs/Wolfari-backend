                "schema": {
                  "type": "object",
                  "required": ["data", "meta"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Operation"
                    },
                    "meta": {
                      "type": "object",
                      "required": ["correlation_id"],
                      "properties": {
                        "correlation_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Accepted/pending recovery/needs review; poll same operation ID",
