    "/api/v1/operations/{operation_id}": {
      "get": {
        "operationId": "getLifecycleOperation",
        "description": "Initiator only, even after departure. No Admin bypass; no generic receipt/Trip/Finance disclosure.",
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current durable lifecycle operation state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data", "meta"],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Operation"
                    },
                    "meta": {
                      "type": "object",
                      "required": ["correlation_id"],
                      "properties": {
                        "correlation_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Existing error envelope (no internal Trip/Finance payload)",
            "content": {
