NODE_ENV=development
FINANCE_PORT=3104
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# FINANCE_GRPC_PORT=3204, GATEWAY_FINANCE_SECRET, TRIP_GRPC_TARGET and
# FINANCE_TRIP_SECRET / TRIP_FINANCE_SECRET are generated by pnpm env:init.
# AUTOMATION_FINANCE_SECRET is generated for Automation-only context reads.
# Missing/short credentials deny this RPC; existing Finance features can still start.
# Trip requires FINANCE_GRPC_TARGET for operation recovery. Internal gRPC is loopback/test only.

# MINIO_ENDPOINT, MINIO_ACCESS_KEY and MINIO_SECRET_KEY are generated by pnpm env:init.
# Private bucket wolfari-finance-receipts; unbound uploads expire after 24 hours.
# Concurrent receipt operations per pool (uploads/downloads vs. command attachment checks), 1–64.
FINANCE_RECEIPT_CONCURRENCY=8

# MoMo is disabled by default. Remote mode accepts only the fixed Sandbox API hosts below;
# keep credentials in local environment files or CI secrets, never in Git.
MOMO_SANDBOX_MODE=disabled
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REDIRECT_URL=https://replace.example/payments/momo/result
MOMO_IPN_URL=https://replace.example/api/v1/webhooks/momo

# payOS moves REAL money into the bank account linked to your payOS payment channel. It is
# offered only for funds whose VietQR destination is exactly PAYOS_BANK_CODE + PAYOS_ACCOUNT_NUMBER.
# Keys come from my.payos.vn → Kênh thanh toán; keep them out of Git. See
# docs/architecture/finance-payos.md. live | disabled (mock only under NODE_ENV=test).
PAYOS_MODE=disabled
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Bank short code from GET /api/v1/finance/banks (e.g. MB) and the linked account number.
PAYOS_BANK_CODE=
PAYOS_ACCOUNT_NUMBER=
# Optional fallback return page when a client sends none (http(s)://<gateway>/api/v1/payments/payos/return/<token>).
PAYOS_RETURN_URL=

# Publication requires provisioned Finance consumer bindings and downstream acceptance.
# Keep disabled while the Finance notification consumer is not implemented.
FINANCE_OUTBOX_ENABLED=false
# RABBITMQ_URL is generated by pnpm env:init; no credentials belong in this template.
# MoMo test-gateway QR checkout (never in production). Empty credentials use MoMo's public test partner.
MOMO_CHECKOUT_MODE=disabled
MOMO_CHECKOUT_PARTNER_CODE=
MOMO_CHECKOUT_ACCESS_KEY=
MOMO_CHECKOUT_SECRET_KEY=
