NODE_ENV=development
FINANCE_PORT=3104
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# FINANCE_GRPC_PORT=3204, GATEWAY_FINANCE_SECRET, TRIP_GRPC_TARGET and
# FINANCE_TRIP_SECRET / TRIP_FINANCE_SECRET are generated by pnpm env:init.
# AUTOMATION_FINANCE_SECRET is generated for Automation-only context reads.
# Missing/short credentials deny this RPC; existing Finance features can still start.
# Trip requires FINANCE_GRPC_TARGET for operation recovery. Internal gRPC is loopback/test only.

# MINIO_ENDPOINT, MINIO_ACCESS_KEY and MINIO_SECRET_KEY are generated by pnpm env:init.
# Private bucket wolfari-finance-receipts; unbound uploads expire after 24 hours.

# MoMo is disabled by default. Remote mode accepts only the fixed Sandbox API hosts below;
# keep credentials in local environment files or CI secrets, never in Git.
MOMO_SANDBOX_MODE=disabled
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REDIRECT_URL=https://replace.example/payments/momo/result
MOMO_IPN_URL=https://replace.example/api/v1/webhooks/momo
