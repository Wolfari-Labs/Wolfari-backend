NODE_ENV=development
GATEWAY_PORT=3000

# Identity/Trip/Finance/Automation targets, service secrets and GATEWAY_CSRF_KEY are generated by pnpm env:init.

# Bank webhook (SePay). Set one of these to accept POST /api/v1/webhooks/bank/sepay; unset = 503.
# BANK_WEBHOOK_SEPAY_SECRET=<HMAC secret shown once in my.sepay.vn when creating the webhook>
# BANK_WEBHOOK_SEPAY_API_KEY=<API key, if the webhook uses "Authorization: Apikey">
