NODE_ENV=development
AUTOMATION_PORT=3105
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
PRICE_WATCH_WORKER_ENABLED=false
AUTOMATION_FINANCE_NOTIFICATION_ENABLED=false
PRICE_WATCH_WORKER_POLL_MS=1000
PRICE_WATCH_WORKER_BATCH_SIZE=20
PRICE_WATCH_ATTEMPT_LEASE_MS=30000
PRICE_WATCH_PROVIDER_TIMEOUT_MS=5000

# FINANCE_GRPC_TARGET and AUTOMATION_FINANCE_SECRET are generated for Finance context reads.
# This configuration does not enable a notification delivery worker.
# gRPC targets, internal secrets and AUTOMATION_CURSOR_SECRET are generated by pnpm env:init.

# Personal reminder scheduler and Expo external push delivery (independent flags).
REMINDER_WORKER_ENABLED=false
PUSH_DELIVERY_ENABLED=false
# Expo enhanced push security access token; server-only, never EXPO_PUBLIC_*.
EXPO_PUSH_ACCESS_TOKEN=
