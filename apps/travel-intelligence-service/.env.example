NODE_ENV=development
TRAVEL_PORT=3103
GEOAPIFY_API_KEY=
# TRAVEL_GRPC_PORT, GATEWAY_TRAVEL_SECRET and PLACE_SELECTION_SECRET are paired by env:init.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# TRIP_GRPC_TARGET and TRAVEL_TRIP_SECRET are generated by pnpm env:init.

# MAP-POI: self-hosted OSRM (car profile) for POST /api/v1/travel/route. See README "OSRM".
OSRM_URL=http://127.0.0.1:5001
# Optional foot/bike OSRM instances; without them WALKING/CYCLING answer 503 (never the car profile).
OSRM_WALKING_URL=
OSRM_CYCLING_URL=
# Demo only (ignored in production): true uses router.project-osrm.org and routing.openstreetmap.de
# for all three modes (max 1 request/s, non-commercial, results cached 7 days, show OSM credit).
OSRM_PUBLIC_DEMO=false
# Optional User-Agent for OSRM requests; default identifies the app without personal data.
OSRM_USER_AGENT=

# FR-TI01 weather: Open-Meteo free API (non-commercial use, no key, credit Open-Meteo.com).
OPEN_METEO_URL=https://api.open-meteo.com/v1/
# true = deterministic offline forecasts labelled is_mock (tests, demos without network).
TRAVEL_WEATHER_MOCK=false
# TRIP_TRAVEL_SECRET (Trip -> Travel recommendations) is generated by pnpm env:init.

# POI-IMAGES: licensed POI photos (bucket wolfari-poi-images).
# MINIO_ENDPOINT, MINIO_ACCESS_KEY and MINIO_SECRET_KEY are generated by pnpm env:init.
