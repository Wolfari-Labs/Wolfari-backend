NODE_ENV=development
TRIP_PORT=3102
TRIP_GRPC_PORT=3202
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# GATEWAY_TRIP_SECRET, FINANCE_TRIP_SECRET, TRAVEL_TRIP_SECRET and
# AUTOMATION_TRIP_SECRET are generated by pnpm env:init.
# Invitation config is also added by env:init: TRIP_INVITATION_TOKEN_KEY (independent
# 32-byte hex key), TRIP_INVITATION_LINK_BASE_URL, IDENTITY_GRPC_TARGET,
# TRIP_IDENTITY_SECRET and RABBITMQ_URL. Never reuse IDENTITY_TOKEN_KEY.
# TRIP_OUTBOX_ENABLED=false is reserved for the PostgreSQL-only test harness.
