      "type": "string",
      "format": "uuid"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInt": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "accountStatusChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "status",
        "user_version"
