    {
      "oneOf": [
        {
          "properties": {
            "actor_user_id": {
              "$ref": "#/definitions/uuid"
            },
            "system_actor": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "actor_user_id": {
              "type": "null"
            },
            "system_actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "event_type": {
              "const": "AccountStatusChanged"
            },
            "producer": {
              "const": "Identity"
            },
            "aggregate_type": {
              "const": "User"
            },
            "payload": {
              "$ref": "#/definitions/accountStatusChanged"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "MemberInvited"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Invitation"
            },
            "payload": {
              "$ref": "#/definitions/memberInvited"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "PlanUpdated"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Plan"
            },
            "payload": {
              "$ref": "#/definitions/planUpdated"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "MemberLeft"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Membership"
            },
            "payload": {
              "$ref": "#/definitions/membershipChanged"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "MemberRemoved"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Membership"
            },
            "payload": {
              "$ref": "#/definitions/membershipChanged"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "TripArchived"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Trip"
            },
            "payload": {
              "$ref": "#/definitions/tripRevision"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "TripDeleted"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Trip"
            },
            "payload": {
              "$ref": "#/definitions/tripDeleted"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "TripReopened"
            },
            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "Trip"
            },
            "payload": {
              "$ref": "#/definitions/tripRevision"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ContributionRequested"
            },
            "producer": {
              "const": "Finance"
            },
            "aggregate_type": {
              "const": "Fund"
            },
            "payload": {
              "$ref": "#/definitions/contributionRequested"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ContributionUpdated"
            },
            "producer": {
              "const": "Finance"
            },
            "aggregate_type": {
              "const": "Fund"
            },
            "payload": {
              "$ref": "#/definitions/contributionUpdated"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ClosureRequested"
            },
            "producer": {
              "const": "Finance"
            },
            "aggregate_type": {
              "const": "Fund"
            },
            "payload": {
              "$ref": "#/definitions/closureRequested"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ClosureCancelled"
            },
            "producer": {
              "const": "Finance"
            },
            "aggregate_type": {
              "const": "Fund"
            },
            "payload": {
              "$ref": "#/definitions/closureState"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "FinanceClosed"
            },
            "producer": {
              "const": "Finance"
            },
            "aggregate_type": {
              "const": "Fund"
            },
            "payload": {
              "$ref": "#/definitions/closureState"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "GenerateExport"
