{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wolfari.local/contracts/events/v1/event.schema.json",
  "title": "WolfariEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "causation_id",
    "operation_id",
    "trip_id",
    "actor_user_id",
    "system_actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/definitions/uuid"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "#/definitions/instant"
    },
    "producer": {
      "enum": [
        "Identity",
        "Trip",
        "Finance",
        "ExportWorker"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "aggregate_id": {
      "$ref": "#/definitions/uuid"
    },
    "aggregate_version": {
      "$ref": "#/definitions/positiveInt"
    },
    "correlation_id": {
      "$ref": "#/definitions/uuid"
    },
    "causation_id": {
      "oneOf": [
        {
          "$ref": "#/definitions/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "oneOf": [
        {
          "$ref": "#/definitions/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "trip_id": {
      "oneOf": [
        {
          "$ref": "#/definitions/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_user_id": {
      "oneOf": [
        {
          "$ref": "#/definitions/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_actor": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
