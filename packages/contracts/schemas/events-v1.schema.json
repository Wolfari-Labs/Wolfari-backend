            "aggregate_type": {
              "const": "ExportJob"
            },
            "payload": {
              "$ref": "#/definitions/exportStarted"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ExportCompleted"
            },
            "producer": {
              "const": "ExportWorker"
            },
            "aggregate_type": {
              "const": "ExportJob"
            },
            "payload": {
              "$ref": "#/definitions/exportCompleted"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ExportFailed"
