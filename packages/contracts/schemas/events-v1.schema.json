            "producer": {
              "const": "Trip"
            },
            "aggregate_type": {
              "const": "ExportJob"
            },
            "payload": {
              "$ref": "#/definitions/generateExport"
            }
          }
        },
        {
          "properties": {
            "event_type": {
              "const": "ExportStarted"
