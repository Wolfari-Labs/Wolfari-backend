        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "invitation_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "changedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "action"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "action": {
          "enum": [
            "UPSERT",
            "DELETE"
          ]
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "source_version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "source_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "planUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "plan_version",
        "changed_entities",
        "source_version",
        "tombstones"
      ],
      "properties": {
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "plan_version": {
          "$ref": "#/definitions/positiveInt"
        },
        "changed_entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/changedEntity"
          }
        },
        "source_version": {
          "$ref": "#/definitions/positiveInt"
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tombstone"
          }
        }
      }
    },
    "membershipChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "user_id",
        "membership_revision"
      ],
      "properties": {
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "user_id": {
          "$ref": "#/definitions/uuid"
        },
        "membership_revision": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "tripRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "export_revision"
      ],
      "properties": {
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "export_revision": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "tripDeleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "export_revision",
        "deleted_at"
      ],
      "properties": {
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "export_revision": {
          "$ref": "#/definitions/positiveInt"
        },
        "deleted_at": {
          "$ref": "#/definitions/instant"
        }
      }
    },
    "contributionRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fund_id",
        "trip_id",
        "request_id",
        "contribution_ids",
        "finance_version"
      ],
      "properties": {
        "fund_id": {
          "$ref": "#/definitions/uuid"
        },
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "request_id": {
          "$ref": "#/definitions/uuid"
        },
        "contribution_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/uuid"
          }
        },
        "finance_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "contributionUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fund_id",
        "trip_id",
        "contribution_id",
        "status",
        "finance_version"
      ],
      "properties": {
        "fund_id": {
          "$ref": "#/definitions/uuid"
        },
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "contribution_id": {
          "$ref": "#/definitions/uuid"
        },
        "status": {
          "enum": [
            "PENDING",
            "TRANSFER_REPORTED",
            "CONFIRMED",
            "WAIVED",
            "CANCELLED"
          ]
        },
        "finance_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "closureRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fund_id",
        "trip_id",
        "closure_id",
        "snapshot_hash",
        "finance_version"
      ],
      "properties": {
        "fund_id": {
          "$ref": "#/definitions/uuid"
        },
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "closure_id": {
          "$ref": "#/definitions/uuid"
        },
        "snapshot_hash": {
          "$ref": "#/definitions/sha256"
        },
        "finance_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "closureState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fund_id",
        "trip_id",
        "closure_id",
        "finance_version"
      ],
      "properties": {
        "fund_id": {
          "$ref": "#/definitions/uuid"
        },
        "trip_id": {
          "$ref": "#/definitions/uuid"
        },
        "closure_id": {
          "$ref": "#/definitions/uuid"
        },
        "finance_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "generateExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "job_version",
        "snapshot_key",
        "snapshot_hash",
        "snapshot_schema_version",
        "format",
        "preset_version",
        "result_key"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "attempt_id": {
          "$ref": "#/definitions/uuid"
        },
        "job_version": {
          "$ref": "#/definitions/positiveInt"
        },
        "snapshot_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "snapshot_hash": {
          "$ref": "#/definitions/sha256"
        },
        "snapshot_schema_version": {
          "$ref": "#/definitions/positiveInt"
        },
        "format": {
          "enum": [
            "XLSX",
            "PDF",
            "PNG"
          ]
        },
        "preset_version": {
          "$ref": "#/definitions/positiveInt"
        },
        "result_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "exportStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "attempt_id": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "exportCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "result_key",
        "sha256",
        "mime_type",
        "size_bytes",
        "completed_at"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "attempt_id": {
          "$ref": "#/definitions/uuid"
