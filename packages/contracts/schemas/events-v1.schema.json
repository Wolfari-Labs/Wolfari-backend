      "properties": {
        "user_id": {
          "$ref": "#/definitions/uuid"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "LOCKED",
            "DELETION_PENDING",
            "ANONYMIZED"
          ]
        },
        "user_version": {
          "$ref": "#/definitions/positiveInt"
        }
      }
    },
    "memberInvited": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invitation_id",
        "trip_id",
        "invitation_version"
