      "properties": {
        "job_id": {
          "$ref": "#/definitions/uuid"
        },
        "attempt_id": {
          "$ref": "#/definitions/uuid"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "retryable": {
